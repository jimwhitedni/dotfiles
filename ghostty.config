# ===== 字體 =====
# 系統上這個家族的正確名稱是 "JetBrainsMono Nerd Font Mono"（ghostty +list-fonts）。
# 之前兩份設定都寫錯：一份少了 " Mono"、另一份多一個 t（"Fontt"），
# 兩種都靜默 fallback 到預設字體。
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# ===== 視窗 =====
window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = tabs
window-save-state = always

# ===== 第一個分頁直接開主控台 =====
#
# initial-command 只作用於第一個 terminal surface，後續 cmd+t / cmd+n 仍是普通
# shell —— 用 command 會把每個分頁都劫持掉。
#
# cc-monitor 跑在自己的 tmux session（monitor）裡。左邊是 session 清單、右邊是選中
# 那個的畫面，兩欄都由 cc-monitor 自己畫；按 a 才真的過去那個 session，C-a m 回來。
#
# 它不會去搬任何 pane。搬過一次：pane 一旦離開 monitor session，那個只有一個 pane
# 的 session 就被 tmux 銷毀，於是回不來、-A 找不到它、每開一次就在別人的 window 裡
# 留下一個殼。兩個 session 的 pane 沒有辦法在不毀掉其中一個的前提下並排。
#
# -A：session 已存在就直接 attach，不會又開一個。這同時也啟動了 tmux server，
# 所以 continuum 的自動還原照常觸發（它掛在 server 啟動時）。
#
# 結尾的 exec zsh 是為了讓 q 離開之後還有個可用的 shell，而不是整個分頁關掉：
# pane 的指令就是 cc-monitor，它一結束 pane 就會死，連帶整個 monitor session。
# 留一個 shell 在原地，按 q 之後打 cc-monitor 就回來了。
initial-command = /bin/zsh -ic "tmux new-session -A -s monitor 'cc-monitor; exec zsh -i'; exec zsh -i"

# ===== Shell Integration =====
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ===== 快捷鍵 =====
# 分頁不需要自己綁：cmd+t、cmd+1..8、cmd+9、cmd+shift+[ ] 都是 ghostty 內建的。
keybind = cmd+shift+up=jump_to_prompt:-1
keybind = cmd+shift+down=jump_to_prompt:1
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# ===== 主題（跟隨系統深淺色）=====
theme = light:Apple System Colors Light,dark:Dracula

# ===== 其他 =====
copy-on-select = clipboard
mouse-hide-while-typing = true
macos-option-as-alt = left
