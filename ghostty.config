# ===== 字體 =====
# 系統上這個家族的正確名稱是 "JetBrainsMono Nerd Font Mono"（ghostty +list-fonts）。
# 之前兩份設定都寫錯：一份少了 " Mono"、另一份多一個 t（"Fontt"），
# 兩種都靜默 fallback 到預設字體。
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# ===== 視窗 =====
window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = tabs
window-save-state = always

# ===== 第一個分頁直接開主控台 =====
#
# initial-command 只作用於第一個 terminal surface，後續 cmd+t / cmd+n 仍是普通
# shell —— 用 command 會把每個分頁都劫持掉。
#
# tmux start-server 是給 continuum 用的：它的自動還原是掛在 tmux server 啟動時，
# 而 cc-monitor 自己不會啟動 server，所以重開機後沒人去碰 tmux 的話，session
# 永遠不會被還原回來。
#
# 結尾的 exec zsh 是為了讓 q 離開 cc-monitor 之後還有個可用的 shell，
# 而不是整個分頁關掉。
initial-command = /bin/zsh -ic "tmux start-server; cc-monitor; exec zsh -i"

# ===== Shell Integration =====
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ===== 快捷鍵 =====
# 分頁不需要自己綁：cmd+t、cmd+1..8、cmd+9、cmd+shift+[ ] 都是 ghostty 內建的。
keybind = cmd+shift+up=jump_to_prompt:-1
keybind = cmd+shift+down=jump_to_prompt:1
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# ===== 主題（跟隨系統深淺色）=====
theme = light:Apple System Colors Light,dark:Dracula

# ===== 其他 =====
copy-on-select = clipboard
mouse-hide-while-typing = true
macos-option-as-alt = left
